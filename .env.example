# ==============================================================================
# BROWSER AUTOMATION AGENT - CONFIGURATION SPECIFICATION
# ==============================================================================

# LLM Provider Configuration
LLM_PROVIDER=gemini
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Google Gemini API Configuration (Official @google/genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Browser Automation & Playwright Configuration
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=50
BROWSER_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
ELEMENT_TIMEOUT=10000
DEFAULT_ACTION_TIMEOUT=15000
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800

# Execution & Safety Guardrails
TASK_TIMEOUT=180000
MAX_ACTION_RETRIES=3
MAX_REPLANS=3
MAX_STEPS_PER_TASK=25
REQUIRE_CONFIRMATION_FOR_HIGH_RISK=true
ALLOW_FILE_DOWNLOADS=true
DOWNLOAD_DIR=./downloads

# Observability & Tracing
LOG_LEVEL=info
ENABLE_EXECUTION_TRACING=true
CAPTURE_SCREENSHOT_ON_FAILURE=true

# Server Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# External API Integrations (Milestone 3)
DUMMYJSON_API_BASE_URL=https://dummyjson.com
API_REQUEST_TIMEOUT_MS=5000

# Feature Flags
ENABLE_API_FIRST_ROUTING=true
ENABLE_PAGE_CAPABILITY_DETECTION=true
ENABLE_PROMPT_INJECTION_DEFENSE=true
